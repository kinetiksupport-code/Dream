{
  "description": "30 preguntas tipo PAU con respuesta conocida (Matemáticas, Lengua, Historia y Geografía). Se mide si acierta (mustMatchAny) y si no inventa. Son preguntas de concepto, no deberes: puede dar el dato.",
  "defaults": { "noDuplicateNumbers": true },
  "cases": [
    { "id": "mat-derivada-1", "messages": [{ "role": "user", "content": "¿Cuál es la derivada de f(x) = x^3 − 6x^2 + 9x?" }], "expect": { "mustMatchAny": ["3x\\^?2\\s*[−-]\\s*12x\\s*\\+\\s*9", "3x²\\s*[−-]\\s*12x\\s*\\+\\s*9"] } },
    { "id": "mat-limite", "messages": [{ "role": "user", "content": "¿Cuánto vale el límite de sen(x)/x cuando x tiende a 0?" }], "expect": { "mustMatchAny": ["\\b1\\b"] } },
    { "id": "mat-integral", "messages": [{ "role": "user", "content": "¿Cuál es una primitiva de 2x?" }], "expect": { "mustMatchAny": ["x\\^?2", "x²"] } },
    { "id": "mat-determinante", "messages": [{ "role": "user", "content": "¿Cuál es el determinante de la matriz [[2, 1], [3, 4]]?" }], "expect": { "mustMatchAny": ["\\b5\\b"] } },
    { "id": "mat-probabilidad", "messages": [{ "role": "user", "content": "Si lanzo dos dados, ¿qué probabilidad hay de que sumen 7?" }], "expect": { "mustMatchAny": ["1/6", "6/36", "\\\\frac\\{1\\}\\{6\\}"] } },
    { "id": "mat-rango", "messages": [{ "role": "user", "content": "¿Qué dice el teorema de Rouché-Frobenius?" }], "expect": { "mustMatchAny": ["rango"] } },
    { "id": "mat-bolzano", "messages": [{ "role": "user", "content": "¿Qué dice el teorema de Bolzano?" }], "expect": { "mustMatchAny": ["continua", "signo"] } },
    { "id": "mat-vectorial", "messages": [{ "role": "user", "content": "¿Qué da el producto escalar de dos vectores perpendiculares?" }], "expect": { "mustMatchAny": ["\\b0\\b|cero"] } },
    { "id": "lengua-generacion-27", "messages": [{ "role": "user", "content": "¿Qué poeta de la Generación del 27 escribió Romancero gitano?" }], "expect": { "mustMatchAny": ["Lorca"] } },
    { "id": "lengua-98", "messages": [{ "role": "user", "content": "¿Quién escribió Niebla?" }], "expect": { "mustMatchAny": ["Unamuno"] } },
    { "id": "lengua-celestina", "messages": [{ "role": "user", "content": "¿Quién es el autor de La Celestina?" }], "expect": { "mustMatchAny": ["Fernando de Rojas"] } },
    { "id": "lengua-subordinada", "messages": [{ "role": "user", "content": "¿Qué tipo de subordinada es 'que vengas' en 'Quiero que vengas'?" }], "expect": { "mustMatchAny": ["sustantiv"] } },
    { "id": "lengua-perifrasis", "messages": [{ "role": "user", "content": "¿Qué es una perífrasis verbal?" }], "expect": { "mustMatchAny": ["auxiliar"] } },
    { "id": "lengua-esperpento", "messages": [{ "role": "user", "content": "¿Qué autor creó el esperpento?" }], "expect": { "mustMatchAny": ["Valle-Incl[aá]n"] } },
    { "id": "lengua-cela", "messages": [{ "role": "user", "content": "¿Quién escribió La colmena?" }], "expect": { "mustMatchAny": ["Cela"] } },
    { "id": "lengua-delibes", "messages": [{ "role": "user", "content": "¿Quién escribió Cinco horas con Mario?" }], "expect": { "mustMatchAny": ["Delibes"] } },
    { "id": "hist-cadiz", "messages": [{ "role": "user", "content": "¿En qué año se aprobó la Constitución de Cádiz?" }], "expect": { "mustMatchAny": ["1812"] } },
    { "id": "hist-desamortizacion", "messages": [{ "role": "user", "content": "¿Qué ministro impulsó la desamortización de 1836?" }], "expect": { "mustMatchAny": ["Mendiz[aá]bal"] } },
    { "id": "hist-restauracion", "messages": [{ "role": "user", "content": "¿Quién ideó el sistema político de la Restauración?" }], "expect": { "mustMatchAny": ["C[aá]novas"] } },
    { "id": "hist-segunda-republica", "messages": [{ "role": "user", "content": "¿En qué fecha se proclamó la Segunda República española?" }], "expect": { "mustMatchAny": ["1931"] } },
    { "id": "hist-guerra-civil", "messages": [{ "role": "user", "content": "¿En qué años fue la Guerra Civil española?" }], "expect": { "mustMatchAny": ["1936", "1939"] } },
    { "id": "hist-constitucion-78", "messages": [{ "role": "user", "content": "¿Cuándo se aprobó en referéndum la Constitución de 1978?" }], "expect": { "mustMatchAny": ["6 de diciembre"] } },
    { "id": "hist-reyes-catolicos", "messages": [{ "role": "user", "content": "¿En qué año terminó la conquista de Granada?" }], "expect": { "mustMatchAny": ["1492"] } },
    { "id": "hist-utrecht", "messages": [{ "role": "user", "content": "¿Qué tratado puso fin a la Guerra de Sucesión española?" }], "expect": { "mustMatchAny": ["Utrecht"] } },
    { "id": "geo-rio", "messages": [{ "role": "user", "content": "¿Cuál es el río más largo que nace y desemboca en España?" }], "expect": { "mustMatchAny": ["Ebro"] } },
    { "id": "geo-clima", "messages": [{ "role": "user", "content": "¿Qué clima tiene la mayor parte del interior peninsular español?" }], "expect": { "mustMatchAny": ["mediterr[aá]neo continentali", "continental"] } },
    { "id": "geo-pico", "messages": [{ "role": "user", "content": "¿Cuál es el pico más alto de España?" }], "expect": { "mustMatchAny": ["Teide"] } },
    { "id": "geo-comunidades", "messages": [{ "role": "user", "content": "¿Cuántas comunidades autónomas tiene España?" }], "expect": { "mustMatchAny": ["17|diecisiete"] } },
    { "id": "geo-meseta", "messages": [{ "role": "user", "content": "¿Qué sistema montañoso divide la Meseta en dos submesetas?" }], "expect": { "mustMatchAny": ["Central"] } },
    { "id": "geo-poblacion", "messages": [{ "role": "user", "content": "¿Qué es el éxodo rural?" }], "expect": { "mustMatchAny": ["campo|rural", "ciudad"] } }
  ]
}
