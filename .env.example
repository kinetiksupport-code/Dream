NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_DREAM_API_URL=
# Cloudflare Turnstile (docs/turnstile.md). Pública. La secreta (TURNSTILE_SECRET_KEY) va solo en Supabase.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Canonical address for the Google sign-in return (production: https://www.edudream.es).
# Local and Vercel previews ignore it and return to their own address.
NEXT_PUBLIC_SITE_URL=

# Public project configuration (never a personal API token)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_SENTRY_DSN=
# Server-only. Provision through your deployment secret store.
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Server-only maintenance mode (middleware.ts, lib/maintenance.ts).
MAINTENANCE_MODE=
MAINTENANCE_COOKIE_SECRET=

# Panel de administración (docs/PANEL_ADMIN.md). Solo en el servidor: sin NEXT_PUBLIC_.
# Ruta del panel; por defecto /revision. Debe coincidir con el secreto de dream-api.
ADMIN_PANEL_PATH=
