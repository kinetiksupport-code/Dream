# Supabase automatically provisions SUPABASE_URL/ANON_KEY/SERVICE_ROLE_KEY on Edge.
# Set provider secrets ONLY in Supabase's secret store; Vercel does not synchronize them.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
# Optional legacy fourth slot; never rotate accounts to evade 429.
GROQ_API_KEY_4=
TAVILY_API_KEY_1=
TAVILY_API_KEY_2=
# Legacy fallback is only used when neither numbered Tavily key is configured.
TAVILY_API_KEY=
DREAM_ALLOWED_ORIGINS=
# Verify a conservative vision input-token ceiling against the actual provider model.
DREAM_VISION_INPUT_TOKEN_CEILING=
DREAM_EDGE_SENTRY_DSN=
DREAM_ENVIRONMENT=
# Moderación y antiabuso (docs/MODERACION.md). Todo apagado por defecto.
# off | observe | enforce. Empieza en observe y revisa antes de pasar a enforce.
MOD_MODE=
# Secreto largo (mínimo 32 caracteres) para la huella de IP. Nunca se imprime.
MOD_IP_PEPPER=
# Cabecera de la que se lee la IP. Solo la que pone la plataforma de confianza.
MOD_IP_HEADER=
# Solo si MOD_IP_HEADER=x-forwarded-for: qué salto desde la derecha (1 = el último).
MOD_IP_XFF_HOPS=
# Mantenimiento también en el backend (README): activar a la vez que MAINTENANCE_MODE.
DREAM_MAINTENANCE_MODE=
DREAM_MAINTENANCE_ALLOWED_EMAILS=
# Baneo automático por evasión (B3). Apagado por defecto: sin "true" el sistema
# solo PROPONE el baneo en el panel. Revisar antes el aviso legal (RGPD art. 22).
MOD_AUTO_BAN_ENABLED=
# Entradas mínimas para confirmar (entre 4 y 7; por defecto 4).
MOD_OBS_MIN_ENTRIES=
# Panel de administración (docs/PANEL_ADMIN.md). Sin ADMIN_EMAIL nadie es administrador.
ADMIN_EMAIL=
# Debe coincidir con el ADMIN_PANEL_PATH de Vercel. Por defecto /revision.
ADMIN_PANEL_PATH=
